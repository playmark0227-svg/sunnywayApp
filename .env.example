# --- Sunnyway App 環境変数サンプル ---
# このファイルをコピーして .env を作成してください:  cp .env.example .env

# DB 接続先（開発は SQLite。本番は PostgreSQL 等に差し替え）
DATABASE_URL="file:./dev.db"

# セッション JWT 署名キー。本番では必ず十分に長いランダム値へ変更すること。
# 生成例:  openssl rand -base64 48
JWT_SECRET="dev-only-change-me-please-use-a-long-random-string"

# 管理画面のセッション有効期間（時間）
SESSION_TTL_HOURS="12"
